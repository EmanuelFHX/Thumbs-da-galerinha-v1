rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function playerPath(roomCode, playerId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/players/$(playerId);
    }

    function usernamePath(roomCode, usernameKey) {
      return /databases/$(database)/documents/rooms/$(roomCode)/usernames/$(usernameKey);
    }

    function roomPath(roomCode) {
      return /databases/$(database)/documents/rooms/$(roomCode);
    }

    function baseImagePath(roomCode, roundNumber, imageId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/rounds/$(roundNumber)/baseImages/$(imageId);
    }

    function roundSubmissionPath(roomCode, roundNumber, playerId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/rounds/$(roundNumber)/submissions/$(playerId);
    }

    function isRoomMember(roomCode) {
      return signedIn() && exists(playerPath(roomCode, request.auth.uid));
    }

    function validRoomCode(roomCode) {
      return roomCode.matches('^[A-HJ-NP-Z2-9]{6}$');
    }

    function validPlayer(data) {
      return data.keys().hasAll([
          'avatarId',
          'isHost',
          'joinedAt',
          'lastSeenAt',
          'ready',
          'username',
          'usernameKey'
        ])
        && data.keys().hasOnly([
          'avatarId',
          'isHost',
          'joinedAt',
          'lastSeenAt',
          'ready',
          'username',
          'usernameKey'
        ])
        && data.avatarId is string
        && data.avatarId.size() >= 1
        && data.avatarId.size() <= 32
        && data.isHost is bool
        && data.joinedAt == request.time
        && data.lastSeenAt == request.time
        && data.ready == true
        && data.username is string
        && data.username.size() >= 2
        && data.username.size() <= 18
        && data.usernameKey is string
        && data.usernameKey.size() >= 1
        && data.usernameKey.size() <= 128;
    }

    function validRoomSettings(settings) {
      return settings is map
        && settings.keys().hasAll([
          'editDurationSeconds',
          'mode',
          'rounds',
          'votesPerPlayer'
        ])
        && settings.keys().hasOnly([
          'editDurationSeconds',
          'mode',
          'rounds',
          'votesPerPlayer'
        ])
        && settings.editDurationSeconds in [120, 240, 360, 600, 900, 1200]
        && settings.mode in ['classic', 'comedy', 'theme', 'chaos']
        && settings.rounds in [1, 3, 5]
        && settings.votesPerPlayer in [1, 2, 3];
    }

    function validSubmission(data) {
      return data.keys().hasAll(['imageData', 'submittedAt'])
        && data.keys().hasOnly(['imageData', 'submittedAt'])
        && data.imageData is string
        && data.imageData.size() > 30
        && data.imageData.size() <= 900000
        && data.imageData.matches('^data:image/webp;base64,.*')
        && data.submittedAt == request.time;
    }

    function validBaseImage(data) {
      return data.keys().hasAll(['imageData', 'submittedAt'])
        && data.keys().hasOnly(['imageData', 'submittedAt'])
        && data.imageData is string
        && data.imageData.size() > 30
        && data.imageData.size() <= 800000
        && data.imageData.matches('^data:image/webp;base64,.*')
        && data.submittedAt == request.time;
    }

    function validRoundVote(roomCode, roundNumber, data) {
      return data.keys().hasAll(['submissionIds', 'votedAt'])
        && data.keys().hasOnly(['submissionIds', 'votedAt'])
        && data.submissionIds is list
        && data.submissionIds.size() >= 1
        && data.submissionIds.size() <= get(roomPath(roomCode)).data.settings.votesPerPlayer
        && data.submissionIds.toSet().size() == data.submissionIds.size()
        && !(request.auth.uid in data.submissionIds)
        && exists(roundSubmissionPath(roomCode, roundNumber, data.submissionIds[0]))
        && (
          data.submissionIds.size() < 2
          || exists(roundSubmissionPath(roomCode, roundNumber, data.submissionIds[1]))
        )
        && (
          data.submissionIds.size() < 3
          || exists(roundSubmissionPath(roomCode, roundNumber, data.submissionIds[2]))
        )
        && data.votedAt == request.time;
    }

    match /rooms/{roomCode} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && validRoomCode(roomCode)
        && request.resource.data.keys().hasAll([
          'createdAt',
          'hostId',
          'maxPlayers',
          'playerCount',
          'settings',
          'status',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'hostId',
          'maxPlayers',
          'playerCount',
          'settings',
          'status',
          'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.maxPlayers == 8
        && request.resource.data.playerCount == 1
        && validRoomSettings(request.resource.data.settings)
        && request.resource.data.status == 'lobby'
        && existsAfter(playerPath(roomCode, request.auth.uid));

      allow update: if signedIn() && (
        (
          resource.data.hostId == request.auth.uid
          && resource.data.status == 'lobby'
          && request.resource.data.status == 'image-submission'
          && request.resource.data.roundNumber == 1
          && request.resource.data.scores is map
          && request.resource.data.scores.size() == 0
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['roundNumber', 'scores', 'status', 'updatedAt'])
        )
        ||
        (
          resource.data.hostId == request.auth.uid
          && resource.data.status == 'image-submission'
          && request.resource.data.status == 'image-voting'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        )
        ||
        (
          resource.data.hostId == request.auth.uid
          && resource.data.status == 'image-voting'
          && request.resource.data.status == 'editing'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.selectedImageId is string
          && request.resource.data.selectedImageData is string
          && exists(baseImagePath(
            roomCode,
            resource.data.roundNumber,
            request.resource.data.selectedImageId
          ))
          && request.resource.data.selectedImageData
            == get(baseImagePath(
              roomCode,
              resource.data.roundNumber,
              request.resource.data.selectedImageId
            )).data.imageData
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['selectedImageData', 'selectedImageId', 'status', 'updatedAt'])
        )
        ||
        (
          resource.data.hostId == request.auth.uid
          && resource.data.status == 'editing'
          && request.resource.data.status == 'thumb-voting'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        )
        ||
        (
          resource.data.hostId == request.auth.uid
          && resource.data.status == 'thumb-voting'
          && request.resource.data.status == 'round-results'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.roundWinnerId is string
          && request.resource.data.scores is map
          && request.resource.data.scores.size() <= resource.data.maxPlayers
          && exists(roundSubmissionPath(
            roomCode,
            resource.data.roundNumber,
            request.resource.data.roundWinnerId
          ))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'roundWinnerId',
              'scores',
              'status',
              'updatedAt'
            ])
        )
        ||
        (
          resource.data.hostId == request.auth.uid
          && resource.data.status == 'round-results'
          && resource.data.roundNumber < resource.data.settings.rounds
          && request.resource.data.status == 'image-submission'
          && request.resource.data.roundNumber == resource.data.roundNumber + 1
          && !('roundWinnerId' in request.resource.data)
          && !('selectedImageData' in request.resource.data)
          && !('selectedImageId' in request.resource.data)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'roundNumber',
              'roundWinnerId',
              'selectedImageData',
              'selectedImageId',
              'status',
              'updatedAt'
            ])
        )
        ||
        (
          resource.data.hostId == request.auth.uid
          && resource.data.status == 'round-results'
          && resource.data.roundNumber == resource.data.settings.rounds
          && request.resource.data.status == 'match-results'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        )
        ||
        (
          resource.data.hostId == request.auth.uid
          && resource.data.status == 'lobby'
          && request.resource.data.status == 'lobby'
          && request.resource.data.updatedAt == request.time
          && validRoomSettings(request.resource.data.settings)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['settings', 'updatedAt'])
        )
        ||
        (
          isRoomMember(roomCode)
          && request.resource.data.hostId == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && get(playerPath(roomCode, resource.data.hostId)).data.lastSeenAt
            < request.time - duration.value(75, 's')
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hostId', 'updatedAt'])
        )
        ||
        (
          resource.data.status == 'lobby'
          && request.resource.data.status == 'lobby'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.playerCount == resource.data.playerCount + 1
          && request.resource.data.playerCount <= resource.data.maxPlayers
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['playerCount', 'updatedAt'])
          && !exists(playerPath(roomCode, request.auth.uid))
          && existsAfter(playerPath(roomCode, request.auth.uid))
        )
      );

      allow delete: if false;

      match /players/{playerId} {
        allow get: if signedIn()
          && (request.auth.uid == playerId || isRoomMember(roomCode));
        allow list: if signedIn()
          && (request.auth.uid == playerId || isRoomMember(roomCode));

        allow create: if signedIn()
          && request.auth.uid == playerId
          && existsAfter(roomPath(roomCode))
          && getAfter(roomPath(roomCode)).data.status == 'lobby'
          && validPlayer(request.resource.data)
          && request.resource.data.isHost
            == (getAfter(roomPath(roomCode)).data.hostId == request.auth.uid)
          && existsAfter(usernamePath(roomCode, request.resource.data.usernameKey))
          && getAfter(usernamePath(roomCode, request.resource.data.usernameKey)).data.playerId
            == request.auth.uid;

        allow update: if signedIn()
          && request.auth.uid == playerId
          && (
            (
              get(roomPath(roomCode)).data.status == 'lobby'
              && validPlayer(request.resource.data)
              && request.resource.data.isHost == resource.data.isHost
              && existsAfter(usernamePath(roomCode, request.resource.data.usernameKey))
              && getAfter(usernamePath(roomCode, request.resource.data.usernameKey)).data.playerId
                == request.auth.uid
            )
            ||
            (
              request.resource.data.lastSeenAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['lastSeenAt'])
            )
          );

        allow delete: if false;
      }

      match /usernames/{usernameKey} {
        allow get: if signedIn();
        allow list: if false;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['playerId'])
          && request.resource.data.playerId == request.auth.uid
          && existsAfter(playerPath(roomCode, request.auth.uid))
          && getAfter(playerPath(roomCode, request.auth.uid)).data.usernameKey == usernameKey;

        allow update: if signedIn()
          && resource.data.playerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['playerId'])
          && request.resource.data.playerId == request.auth.uid
          && existsAfter(playerPath(roomCode, request.auth.uid))
          && getAfter(playerPath(roomCode, request.auth.uid)).data.usernameKey == usernameKey;

        allow delete: if signedIn()
          && resource.data.playerId == request.auth.uid;
      }

      match /rounds/{roundNumber} {
        match /baseImages/{playerId} {
          allow get, list: if isRoomMember(roomCode);

          allow create, update: if signedIn()
            && request.auth.uid == playerId
            && isRoomMember(roomCode)
            && get(roomPath(roomCode)).data.status == 'image-submission'
            && int(roundNumber) == get(roomPath(roomCode)).data.roundNumber
            && validBaseImage(request.resource.data);

          allow delete: if false;
        }

        match /baseImageVotes/{voterId} {
          allow get, list: if isRoomMember(roomCode);

          allow create, update: if signedIn()
            && request.auth.uid == voterId
            && isRoomMember(roomCode)
            && get(roomPath(roomCode)).data.status == 'image-voting'
            && int(roundNumber) == get(roomPath(roomCode)).data.roundNumber
            && request.resource.data.keys().hasAll(['imageId', 'votedAt'])
            && request.resource.data.keys().hasOnly(['imageId', 'votedAt'])
            && request.resource.data.imageId is string
            && exists(baseImagePath(roomCode, roundNumber, request.resource.data.imageId))
            && request.resource.data.votedAt == request.time;

          allow delete: if false;
        }

        match /submissions/{playerId} {
          allow get, list: if isRoomMember(roomCode);

          allow create, update: if signedIn()
            && request.auth.uid == playerId
            && isRoomMember(roomCode)
            && get(roomPath(roomCode)).data.status == 'editing'
            && roundNumber.matches('^[1-5]$')
            && int(roundNumber) == get(roomPath(roomCode)).data.roundNumber
            && validSubmission(request.resource.data);

          allow delete: if false;
        }

        match /votes/{voterId} {
          allow get, list: if isRoomMember(roomCode);

          allow create, update: if signedIn()
            && request.auth.uid == voterId
            && isRoomMember(roomCode)
            && get(roomPath(roomCode)).data.status == 'thumb-voting'
            && roundNumber.matches('^[1-5]$')
            && int(roundNumber) == get(roomPath(roomCode)).data.roundNumber
            && validRoundVote(roomCode, roundNumber, request.resource.data);

          allow delete: if false;
        }
      }
    }
  }
}
